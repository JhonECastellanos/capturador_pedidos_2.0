# ── PostgreSQL (solo infraestructura) ─────────────────────────────
POSTGRES_DB=ambie
POSTGRES_USER=ambie
POSTGRES_PASSWORD=cambia-esta-contrasena

# ── Backend (API) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://ambie:cambia-esta-contrasena@postgres:5432/ambie?schema=public
SESSION_SECRET=cambia-este-secreto-de-sesion
CORS_ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
APP_TIMEZONE=America/Bogota
PORT=3000

# ── Autenticación (JWT) ───────────────────────────────────────────
# Genera uno nuevo con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Debe tener al menos 32 caracteres; la API se niega a arrancar si es más corto.
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SEGUNDOS=900
JWT_REFRESH_TTL_DIAS=7
JWT_ISSUER=ambie-api
JWT_AUDIENCE=ambie

# ── Límite de peticiones (protección contra fuerza bruta) ─────────
RATE_LIMIT_MAX=300
RATE_LIMIT_VENTANA=1 minute

# ── Bootstrap del primer administrador ────────────────────────────
# Se usa UNA sola vez para crear el primer administrador.
BOOTSTRAP_EMAIL=admin@ambie.local
BOOTSTRAP_PASSWORD=cambia-esta-contrasena-inicial

# ── MinIO (almacenamiento de imágenes y comprobantes) ─────────────
MINIO_ROOT_USER=ambie
MINIO_ROOT_PASSWORD=cambia-esta-contrasena-minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=ambie
MINIO_SECRET_KEY=cambia-esta-contrasena-minio
MINIO_BUCKET=ambie-archivos

# ── Frontend (solo variables públicas, NUNCA secretos) ───────────
VITE_API_BASE_URL=/api/v1
VITE_DATOS_ORIGEN=api
# Solo para Vite local; las variables públicas se leen del .env raíz.
API_PROXY_TARGET=http://localhost:3000

# ── Agente CLI (opcional, perfil cli) ────────────────────────────
IA_PROVEEDOR=gemini
IA_MODELO=
GEMINI_API_KEY=
GROQ_API_KEY=
IA_API_KEY=
IA_URL_BASE=
OLLAMA_URL=http://host.docker.internal:11434

ASISTENTE_CONFIG_SECRET=
ASISTENTE_CONFIG_DIR=.ambie-config
VOZ_STT_URL=ws://localhost:2700

# Una instalación independiente por empresa. Nginx sirve SPA y API del mismo origen.
FRONTEND_PORT=8080
FRONTEND_BIND=0.0.0.0
APP_ORIGIN=http://localhost:8080
FRONTEND_MEMORY=128m
FRONTEND_CPUS=0.5
API_MEMORY=512m
API_CPUS=1.0
POSTGRES_MEMORY=512m
POSTGRES_CPUS=1.0
MINIO_MEMORY=384m
MINIO_CPUS=0.5
VOZ_MEMORY=512m
VOZ_CPUS=1.0
# Solo para API fuera de Docker. Compose ya confía en un salto (Nginx).
TRUST_PROXY_HOPS=0
# Archivo local privado, no escribir el token en Compose/Git.
CLOUDFLARE_TOKEN_FILE=.local/cloudflare-token

# Administrador de instalación: migrate lo crea una vez, sin reemplazar claves.
# Vacío reutiliza BOOTSTRAP_PASSWORD solo en la primera creación.
SYSTEM_EMAIL=system@ambie.local
SYSTEM_PASSWORD=
REDIS_MEMORY=128m
REDIS_CPUS=0.5
# API fuera de Docker; Compose usa redis://redis:6379 automáticamente.
CACHE_REDIS_URL=
