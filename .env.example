# ── PostgreSQL (solo infraestructura) ─────────────────────────────
POSTGRES_DB=ambie
POSTGRES_USER=ambie
POSTGRES_PASSWORD=cambia-esta-contrasena

# ── Backend (API) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://ambie:cambia-esta-contrasena@postgres:5432/ambie?schema=public
SESSION_SECRET=cambia-este-secreto-de-sesion
CORS_ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
APP_TIMEZONE=America/Bogota
PORT=3000

# ── Autenticación (JWT) ───────────────────────────────────────────
# Genera uno nuevo con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Debe tener al menos 32 caracteres; la API se niega a arrancar si es más corto.
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SEGUNDOS=900
JWT_REFRESH_TTL_DIAS=7
JWT_ISSUER=ambie-api
JWT_AUDIENCE=ambie

# ── Límite de peticiones (protección contra fuerza bruta) ─────────
RATE_LIMIT_MAX=300
RATE_LIMIT_VENTANA=1 minute

# ── Bootstrap del primer administrador ────────────────────────────
# Se usa UNA sola vez para crear el primer administrador.
BOOTSTRAP_EMAIL=admin@ambie.local
BOOTSTRAP_PASSWORD=cambia-esta-contrasena-inicial

# ── MinIO (almacenamiento de imágenes y comprobantes) ─────────────
MINIO_ROOT_USER=ambie
MINIO_ROOT_PASSWORD=cambia-esta-contrasena-minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=ambie
MINIO_SECRET_KEY=cambia-esta-contrasena-minio
MINIO_BUCKET=ambie-archivos

# ── Frontend (solo variables públicas, NUNCA secretos) ───────────
VITE_API_BASE_URL=/api
