{
  "name": "ambie",
  "version": "1.0.0",
  "private": true,
  "description": "AMBIÉ · Capturador de pedidos — monorepo con frontend, API y contrato compartido",
  "workspaces": [
    "Compartido",
    "Backend",
    "Frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "5.12.5"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.44.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  },
  "scripts": {
    "contrato:build": "npm run build --workspace @ambie/contrato",
    "contrato:watch": "npm run watch --workspace @ambie/contrato",
    "contrato:verificar": "node scripts/verificar-contrato.mjs",
    "api:build": "npm run build --workspace ambie-backend",
    "api:verificar": "npm run verificar --workspace ambie-backend",
    "api:dev": "npm run start:dev --workspace ambie-backend",
    "api:cli": "npm run cli --workspace ambie-backend",
    "front:dev": "npm run dev --workspace capturador-pedido",
    "front:build": "npm run build --workspace capturador-pedido",
    "front:lint": "npm run lint --workspace capturador-pedido",
    "prueba:humo": "npm run prueba:humo --workspace ambie-backend",
    "prueba:asistente": "npm run contrato:build && npm run api:build && node --test Backend/scripts/probar-asistente.cjs",
    "prueba:integracion": "npm run prueba:integracion --workspace ambie-backend",
    "prueba:cache": "node --test scripts/probar-cache-query.mjs",
    "prueba:carga": "node Backend/scripts/probar-carga.cjs",
    "prueba:persistencia": "node Backend/scripts/probar-persistencia.cjs",
    "seguridad:repositorio": "node scripts/verificar-repositorio.mjs",
    "prueba:voz": "node Backend/scripts/integracion-voz.cjs",
    "prueba:voz:audio": "node Backend/scripts/probar-voz-audio-qa.cjs",
    "prueba:asistente:ui": "npm run contrato:build && npm run api:build && npm run front:build && node Backend/scripts/probar-asistente-flujos-ui.cjs",
    "prueba:paneles": "node --env-file=.env Backend/scripts/probar-paneles-ui.cjs",
    "demo:catalogo": "node --env-file=.env Backend/scripts/cargar-demo.cjs",
    "prueba": "npm run prueba --workspace ambie-backend",
    "verificar": "npm run contrato:build && npm run contrato:verificar && npm run api:build && npm run api:verificar && npm run front:build && npm run front:lint",
    "docker:arriba": "docker compose up -d --build",
    "docker:abajo": "docker compose down",
    "docker:limpiar": "docker compose down -v",
    "docker:logs": "docker compose logs -f --tail 200",
    "docker:estado": "docker compose ps"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
