{
  "name": "abinova",
  "version": "1.0.0",
  "private": true,
  "description": "ABINOVA — monorepo con frontend, API y contrato compartido",
  "workspaces": [
    "Compartido",
    "Backend",
    "Frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "5.12.5"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.44.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  },
  "scripts": {
    "contrato:build": "npm run build --workspace @abinova/contrato",
    "contrato:watch": "npm run watch --workspace @abinova/contrato",
    "contrato:verificar": "node scripts/verificar-contrato.mjs",
    "api:build": "npm run build --workspace abinova-backend",
    "api:verificar": "npm run verificar --workspace abinova-backend",
    "api:dev": "npm run start:dev --workspace abinova-backend",
    "front:dev": "npm run contrato:build && npm run dev --workspace abinova-frontend -- --force",
    "front:build": "npm run build --workspace abinova-frontend",
    "front:lint": "npm run lint --workspace abinova-frontend",
    "seguridad:repositorio": "node scripts/verificar-repositorio.mjs",
    "verificar": "npm run contrato:build && npm run contrato:verificar && npm run api:build && npm run api:verificar && npm run front:build && npm run front:lint",
    "docker:arriba": "docker compose up -d --build",
    "docker:abajo": "docker compose down",
    "docker:limpiar": "docker compose down -v",
    "docker:logs": "docker compose logs -f --tail 200",
    "docker:estado": "docker compose ps",
    "workflows:preparar": "node infra/workflows/preparar.mjs",
    "workflows:arriba": "node infra/workflows/iniciar.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
